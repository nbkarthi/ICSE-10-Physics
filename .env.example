# Copy to .env and fill in. .env is gitignored; never commit it.

# Public OAuth client ID from Google Cloud Console (Web application).
# The new site's origin must be listed under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Random string used to sign session cookies. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional shared class password so students can sign in with email + this password instead of Google.
# Leave empty to turn it off. Anyone who knows it can sign in as any email, so share it only with the class.
DEFAULT_PASSWORD=

# Optional access limits (comma separated). Leave both empty to allow any Google account.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Set to 1 when served over HTTPS (production) so the cookie is Secure.
COOKIE_SECURE=0

# Postgres connection (Railway gives you this in production). Tables live in their own schema.
DATABASE_URL=postgresql://localhost/railway
DB_SCHEMA=icse_physics

# Run database migrations when the server starts. Use 1 locally. In production leave it unset and run
# `uv run alembic upgrade head` as a release step (railway.json does this).
AUTO_MIGRATE=1

# Sessions expire this many hours after sign-in; the student then signs in again.
SESSION_HOURS=24
